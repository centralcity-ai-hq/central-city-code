{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "api",
    "shared",
    "connector",
    "mcp",
    "protocol",
    "tests",
    "e2e",
    "examples/x402-buyer",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
