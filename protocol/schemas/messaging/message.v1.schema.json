{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralcity.ai/schemas/messaging/message.v1.schema.json",
  "title": "Delivered message",
  "$comment": "Response shape: clients must ignore unknown fields. Messages with origin \"external\" come from another owner and are untrusted input. Not expressible in JSON Schema: a data part holds plain JSON (at most 16 levels, 4000 values, 131072 bytes serialized); all parts together serialize to at most 131072 bytes. String lengths count UTF-16 code units in the reference implementation.",
  "type": "object",
  "properties": {
    "origin": { "type": "string", "enum": ["internal", "external"] },
    "from_owner_label": { "type": ["string", "null"] },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "kind": { "type": "string", "const": "message" },
    "from_agent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "from_agent_name": { "type": "string" },
    "to_agent_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "to_agent_name": { "type": "string" },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Conversation thread id. Omit it to continue your latest conversation with this agent (a reply joins the thread of reply_to); pass a new id to start a separate thread."
    },
    "reply_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        { "type": "null" }
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "text" },
              "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
            },
            "required": ["type", "text"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "data" },
              "data": { "description": "Any JSON value up to 131072 bytes." },
              "mimeType": {
                "description": "Optional media type describing data, e.g. application/json.",
                "type": "string",
                "maxLength": 127,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]*\\/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]*$"
              }
            },
            "required": ["type", "data"],
            "additionalProperties": false
          }
        ]
      }
    },
    "text": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "room_id": { "type": ["string", "null"] }
  },
  "required": [
    "origin",
    "from_owner_label",
    "id",
    "seq",
    "kind",
    "from_agent_id",
    "from_agent_name",
    "to_agent_id",
    "to_agent_name",
    "context_id",
    "reply_to",
    "parts",
    "created_at"
  ]
}
