{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build && rm -rf dist/.vite",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "api/_bundle/*.map"
    }
  },
  "crons": [
    {
      "path": "/api/cron/count-checkpoint",
      "schedule": "*/5 10-21 * * *"
    },
    {
      "path": "/api/cron/fast-count-check",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/wake-drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/email-drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/base-identity-finalize",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/base-pay-recover",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/base-wallet-sweep",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!(?:api|mcp|oauth|\\.well-known|a2a|j)(?:/|$))[A-Za-z0-9](?:[^/.]*|[^/]*(?:/[^/]+)*/[^/.]+))/",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/how",
      "destination": "/#how",
      "statusCode": 301
    },
    {
      "source": "/answers",
      "destination": "/docs",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/mcp/open",
      "destination": "/api"
    },
    {
      "source": "/mcp/server-card",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/mcp/open/server-card",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/agent-registration.json",
      "destination": "/api"
    },
    {
      "source": "/a2a/:path*",
      "destination": "/api"
    },
    {
      "source": "/a/([0-9A-Za-z]{6})",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?=.*text/html)(?!.*json).*$"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/a/:path*",
      "destination": "/api"
    },
    {
      "source": "/j/:path*",
      "destination": "/api"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api"
    },
    {
      "source": "/docs/index.md",
      "destination": "/docs-index.md"
    },
    {
      "source": "/docs.md",
      "destination": "/docs-index.md"
    },
    {
      "source": "/about",
      "destination": "/share/about.html"
    },
    {
      "source": "/signin",
      "destination": "/app.html"
    },
    {
      "source": "/invite",
      "destination": "/share/invite.html"
    },
    {
      "source": "/connect",
      "destination": "/share/connect.html"
    },
    {
      "source": "/workflows",
      "destination": "/share/workflows.html"
    },
    {
      "source": "/r/([A-Za-z0-9_-]{1,64})",
      "destination": "/app.html"
    },
    {
      "source": "/rooms",
      "destination": "/app.html"
    },
    {
      "source": "/rooms/([A-Za-z0-9_-]{1,64})",
      "destination": "/app.html"
    },
    {
      "source": "/agents",
      "destination": "/app.html"
    },
    {
      "source": "/agents/([A-Za-z0-9_-]{1,64})",
      "destination": "/app.html"
    },
    {
      "source": "/messages",
      "destination": "/app.html"
    },
    {
      "source": "/elric",
      "destination": "/share/elric.html"
    },
    {
      "source": "/results/([A-Za-z0-9_-]{1,64})",
      "destination": "/app.html"
    },
    {
      "source": "/settings",
      "destination": "/app.html"
    },
    {
      "source": "/settings/([A-Za-z0-9_-]{1,64})",
      "destination": "/app.html"
    },
    {
      "source": "/newsletter/confirm",
      "destination": "/app.html"
    },
    {
      "source": "/newsletter/unsubscribe",
      "destination": "/app.html"
    },
    {
      "source": "/downtown",
      "destination": "/share/downtown.html"
    },
    {
      "source": "/privacy",
      "destination": "/share/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/share/terms.html"
    },
    {
      "source": "/security",
      "destination": "/share/security.html"
    },
    {
      "source": "/support",
      "destination": "/share/support.html"
    },
    {
      "source": "/status",
      "destination": "/share/status.html"
    },
    {
      "source": "/privacy-choices",
      "destination": "/share/privacy-choices.html"
    },
    {
      "source": "/acceptable-use",
      "destination": "/share/acceptable-use.html"
    },
    {
      "source": "/dpa",
      "destination": "/share/dpa.html"
    },
    {
      "source": "/imprint",
      "destination": "/share/imprint.html"
    },
    {
      "source": "/contact",
      "destination": "/share/contact.html"
    },
    {
      "source": "/downtown/verify",
      "destination": "/share/downtown/verify.html"
    },
    {
      "source": "/downtown/log",
      "destination": "/share/downtown/log.html"
    },
    {
      "source": "/explorer",
      "destination": "/share/explorer.html"
    },
    {
      "source": "/explorer/base",
      "destination": "/share/explorer/base.html"
    },
    {
      "source": "/docs",
      "destination": "/share/docs.html"
    },
    {
      "source": "/docs/start",
      "destination": "/share/docs/start.html"
    },
    {
      "source": "/docs/rooms",
      "destination": "/share/docs/rooms.html"
    },
    {
      "source": "/docs/room-management",
      "destination": "/share/docs/room-management.html"
    },
    {
      "source": "/docs/coding",
      "destination": "/share/docs/coding.html"
    },
    {
      "source": "/docs/microsoft-copilot",
      "destination": "/share/docs/microsoft-copilot.html"
    },
    {
      "source": "/docs/mistral-le-chat",
      "destination": "/share/docs/mistral-le-chat.html"
    },
    {
      "source": "/docs/api",
      "destination": "/share/docs/api.html"
    },
    {
      "source": "/use-cases",
      "destination": "/share/use-cases.html"
    },
    {
      "source": "/use-cases/claude-and-chatgpt",
      "destination": "/share/use-cases/claude-and-chatgpt.html"
    },
    {
      "source": "/use-cases/gemini-cli-and-claude-code",
      "destination": "/share/use-cases/gemini-cli-and-claude-code.html"
    },
    {
      "source": "/use-cases/multi-ai-research-team",
      "destination": "/share/use-cases/multi-ai-research-team.html"
    },
    {
      "source": "/use-cases/multi-ai-code-review",
      "destination": "/share/use-cases/multi-ai-code-review.html"
    },
    {
      "source": "/use-cases/bring-your-own-agent",
      "destination": "/share/use-cases/bring-your-own-agent.html"
    },
    {
      "source": "/use-cases/cursor-and-claude-code",
      "destination": "/share/use-cases/cursor-and-claude-code.html"
    },
    {
      "source": "/use-cases/team-ai-workspace",
      "destination": "/share/use-cases/team-ai-workspace.html"
    }
  ],
  "headers": [
    {
      "source": "/a/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|mcp(?:/|$)|oauth/|\\.well-known/|a2a/|j/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://mainnet.base.org; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/((?!oauth/).*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/oauth/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/ai-catalog+json\""
        }
      ]
    },
    {
      "source": "/mcp/server-card",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, If-None-Match"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "ETag"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/mcp/open/server-card",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, If-None-Match"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "ETag"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, If-None-Match"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "ETag"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs-index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/docs/start",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/docs/rooms",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/rooms.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/docs/room-management",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/room-management.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/docs/coding",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/coding.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/docs/api",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/api.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/.well-known/mcp-registry-auth",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(rooms|settings|agents|messages|signin|r|results|share|newsletter)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(rooms|settings|agents|messages|signin|r|results|share|newsletter)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(session|elric|public/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(404|index|app)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
